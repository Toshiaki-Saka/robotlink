<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RobotLinkAvalonia.Views"
        x:Class="RobotLinkAvalonia.Views.MainWindow"
        Title="RobotLink — Simulation Visualizer (Avalonia)"
        Width="1200" Height="820"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="6,4">
            <Button DockPanel.Dock="Right" Content="Close" Click="OnClose"
                    Padding="10,4" Background="#E05252" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Open CSV"            Click="OnOpenCsv"       Padding="10,4"/>
                <Button Content="Run Simulation"      Click="OnRunSim"        Padding="10,4"/>
                <Separator Width="1" Margin="2,2"/>
                <Button Content="Plot All"            Click="OnPlotAll"       Padding="10,4"/>
                <Button Content="Play 3-D Animation"  Click="OnPlayAnimation" Padding="10,4"/>
                <Button Content="Stop Animation"      Click="OnStopAnimation" Padding="10,4"/>
            </StackPanel>
        </DockPanel>

        <!-- Split view: graphs on left, animation on right -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*">

            <!-- Left: graph tabs -->
            <TabControl Grid.Column="0" Margin="4,2,2,2">

                <!-- Tab 1: Joint Angles -->
                <TabItem Header="Joint Angles">
                    <Grid RowDefinitions="Auto,*,*,*">
                        <!-- Panel-level title matching matplotlib suptitle -->
                        <TextBlock Grid.Row="0" Text="Joint Angles: Actual vs Desired"
                                   FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <views:ChartControl Grid.Row="1"
                                            YLabel="rad"
                                            Series="{Binding Q1Series}"/>
                        <views:ChartControl Grid.Row="2"
                                            YLabel="rad"
                                            Series="{Binding Q2Series}"/>
                        <views:ChartControl Grid.Row="3"
                                            XLabel="time [s]" YLabel="rad"
                                            Series="{Binding Q3Series}"/>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Torques -->
                <TabItem Header="Torques">
                    <views:ChartControl Title="Joint Torques"
                                        XLabel="time [s]" YLabel="torque [N·m]"
                                        Series="{Binding TorSeries}"/>
                </TabItem>

                <!-- Tab 3: Errors -->
                <TabItem Header="Errors">
                    <Grid RowDefinitions="Auto,*,*">
                        <TextBlock Grid.Row="0" Text="Tracking Errors"
                                   FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <views:ChartControl Grid.Row="1"
                                            YLabel="error [deg]"
                                            Series="{Binding ErrAng}"/>
                        <views:ChartControl Grid.Row="2"
                                            Title="{Binding ErrHandTitle}"
                                            XLabel="time [s]" YLabel="hand position error [mm]"
                                            VLineX="2.0"
                                            Series="{Binding ErrHand}"/>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- Right: 3-D arm animation (always visible) -->
            <views:ArmAnimControl x:Name="AnimControl" Grid.Column="1" Margin="2,2,4,2"/>

        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                Background="#F5F5F5" Padding="6,3">
            <TextBlock Text="{Binding StatusText}" FontSize="11"/>
        </Border>

    </Grid>
</Window>
