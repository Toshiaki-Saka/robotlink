# Default: normalize line endings to LF in the repo, check out as-is
* text=auto eol=lf

# Windows scripts: CRLF on checkout is fine
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings
*.gif  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.dll  binary
*.exe  binary
