<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TlmAvalonia.Views"
        x:Class="TlmAvalonia.Views.MainWindow"
        Width="1180" Height="760"
        Title="Two-link manipulator (C# / Avalonia)">

    <Grid ColumnDefinitions="340,*" Margin="6">

        <!-- ============== LEFT: parameter panel ==============
             CLAUDE.md item 1: NO HeaderedContentControl —
             use TextBlock + Border + StackPanel. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,6,0">
            <StackPanel Spacing="6">

                <!-- ===== Link lengths ===== -->
                <TextBlock Text="Link lengths" FontWeight="Bold" Margin="2,0,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="l1 [m]" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="0.001" Maximum="100"
                                           FormatString="0.0000"
                                           Value="{Binding L1, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="l2 [m]" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="0.001" Maximum="100"
                                           FormatString="0.0000"
                                           Value="{Binding L2, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Joint-angle limits ===== -->
                <TextBlock Text="Joint-angle limits [rad]" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="theta1_min" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="-3.2" Maximum="3.2"
                                           FormatString="0.0000"
                                           Value="{Binding Theta1Min, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="theta1_max" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="-3.2" Maximum="3.2"
                                           FormatString="0.0000"
                                           Value="{Binding Theta1Max, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="theta2_min" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="-3.2" Maximum="3.2"
                                           FormatString="0.0000"
                                           Value="{Binding Theta2Min, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="theta2_max" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="-3.2" Maximum="3.2"
                                           FormatString="0.0000"
                                           Value="{Binding Theta2Max, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Joint angles (sliders) ===== -->
                <TextBlock Text="Joint angles" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="theta1 [rad]"/>
                        <Grid ColumnDefinitions="*,60">
                            <Slider Grid.Column="0"
                                    Minimum="{Binding Theta1Min}"
                                    Maximum="{Binding Theta1Max}"
                                    Value="{Binding Theta1, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Theta1Text}"
                                       FontFamily="Consolas, Menlo, monospace"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="theta2 [rad]"/>
                        <Grid ColumnDefinitions="*,60">
                            <Slider Grid.Column="0"
                                    Minimum="{Binding Theta2Min}"
                                    Maximum="{Binding Theta2Max}"
                                    Value="{Binding Theta2, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Theta2Text}"
                                       FontFamily="Consolas, Menlo, monospace"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== End effector ===== -->
                <TextBlock Text="End effector" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="x_end"/>
                            <TextBlock Grid.Column="1" Text="{Binding XEndText}"
                                       FontFamily="Consolas, Menlo, monospace"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="y_end"/>
                            <TextBlock Grid.Column="1" Text="{Binding YEndText}"
                                       FontFamily="Consolas, Menlo, monospace"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="Reset" Click="OnResetClick" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============== RIGHT: plot + status ============== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto">

            <TextBlock Grid.Row="0" Text="Two-Link Manipulator and Workspace"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <!-- ===== Plot canvas =====
                 CLAUDE.md item 2: Line + StartPoint/EndPoint for grid;
                 Rectangle for plot box. -->
            <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1"
                    Background="White" CornerRadius="2">
                <Canvas x:Name="PlotCanvas" Width="580" Height="580">

                    <!-- Grid lines
                         内側の Canvas に明示サイズが必要。なければ座標系がずれて全線が非表示になる
                         (TROUBLESHOOTING_SIGNAL_LINES.md §原因6) -->
                    <ItemsControl ItemsSource="{Binding GridLines}"
                                  Width="580" Height="580">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas Width="580" Height="580"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line Stroke="#E0E0E0" StrokeThickness="1"
                                      StartPoint="{Binding Start}"
                                      EndPoint  ="{Binding End}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Plot box -->
                    <Rectangle Stroke="Black" StrokeThickness="1" Fill="Transparent"
                               Width="{Binding PlotBoxWidth}"
                               Height="{Binding PlotBoxHeight}"
                               Canvas.Left="{Binding PlotBoxLeft}"
                               Canvas.Top ="{Binding PlotBoxTop}"/>

                    <!-- Boundary curves rendered directly via DrawingContext -->
                    <local:WorkspaceOverlay Segments="{Binding BoundarySegments}"
                                            Width="580" Height="580"/>

                    <!-- Manipulator: two line segments -->
                    <Line Stroke="#1F77B4" StrokeThickness="3"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          StartPoint="{Binding ArmPt0}"
                          EndPoint  ="{Binding ArmPt1}"/>
                    <Line Stroke="#1F77B4" StrokeThickness="3"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          StartPoint="{Binding ArmPt1}"
                          EndPoint  ="{Binding ArmPt2}"/>

                    <!-- Node markers (base + joint2) -->
                    <Ellipse Width="8" Height="8" Fill="#1F77B4"
                             Canvas.Left="{Binding NodeBaseX}" Canvas.Top="{Binding NodeBaseY}"/>
                    <Ellipse Width="8" Height="8" Fill="#1F77B4"
                             Canvas.Left="{Binding NodeMidX}"  Canvas.Top="{Binding NodeMidY}"/>
                    <!-- End-effector dot (larger, dark blue) -->
                    <Ellipse Width="12" Height="12" Fill="#0000B4"
                             Stroke="Black" StrokeThickness="0.6"
                             Canvas.Left="{Binding NodeEndX}" Canvas.Top="{Binding NodeEndY}"/>

                    <!-- Y-axis tick labels (CLAUDE.md item 3) -->
                    <TextBlock Canvas.Left="8" Canvas.Top="32"  FontSize="9" Text="{Binding RefY100}"/>
                    <TextBlock Canvas.Left="8" Canvas.Top="166" FontSize="9" Text="{Binding RefY75}"/>
                    <TextBlock Canvas.Left="8" Canvas.Top="294" FontSize="9" Text="{Binding RefY50}"/>
                    <TextBlock Canvas.Left="8" Canvas.Top="424" FontSize="9" Text="{Binding RefY25}"/>
                    <TextBlock Canvas.Left="8" Canvas.Top="538" FontSize="9" Text="{Binding RefY0}"/>

                    <!-- X-axis tick labels -->
                    <TextBlock Canvas.Left="34"  Canvas.Top="546" FontSize="9" Text="{Binding RefX0}"/>
                    <TextBlock Canvas.Left="160" Canvas.Top="546" FontSize="9" Text="{Binding RefX25}"/>
                    <TextBlock Canvas.Left="284" Canvas.Top="546" FontSize="9" Text="{Binding RefX50}"/>
                    <TextBlock Canvas.Left="408" Canvas.Top="546" FontSize="9" Text="{Binding RefX75}"/>
                    <TextBlock Canvas.Left="530" Canvas.Top="546" FontSize="9" Text="{Binding RefX100}"/>

                    <!-- Axis name labels -->
                    <TextBlock Canvas.Left="280" Canvas.Top="560" FontSize="10" Text="X"/>
                    <TextBlock Canvas.Left="22"  Canvas.Top="280" FontSize="10" Text="Y"/>

                    <!-- Legend
                         Line 要素は StartPoint/EndPoint が同じ Y になると高さ 0 でレイアウト崩れ。
                         Rectangle を色サンプルとして使う (AVALONIA_NOTES.md §11) -->
                    <Border Canvas.Left="370" Canvas.Top="44"
                            Background="#EEFFFFFF" BorderBrush="#BBB" BorderThickness="1" Padding="4">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="18" Height="2" Fill="#DC322F" VerticalAlignment="Center"/>
                                <TextBlock Text="Workspace boundary (-theta2)" FontSize="9"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="18" Height="2" Fill="#3CA03C" VerticalAlignment="Center"/>
                                <TextBlock Text="Workspace boundary (+theta2)" FontSize="9"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="18" Height="3" Fill="#1F77B4" VerticalAlignment="Center"/>
                                <TextBlock Text="Manipulator" FontSize="9"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#0000B4"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="End Effector" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Border>

            <!-- ===== Status ===== -->
            <Border Grid.Row="2" BorderBrush="#888" BorderThickness="1"
                    Background="#F8F8F8" CornerRadius="2" Padding="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="Consolas, Menlo, monospace" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>
